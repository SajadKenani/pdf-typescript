{
  "name": "emails",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc && npm run build:backend && npm run build:server",
      "build:server": "babel server.js --out-dir dist --extensions .js",
    "build:backend": "babel src --out-dir dist/src --extensions .js,.jsx,.ts,.tsx --ignore src/frontend/**",
    "start": "node dist/server.js",
    "clean": "rm -rf .turbo node_modules dist",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "vite": "vite --host"
  },
  "dependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/node": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@react-email/components": "1.0.1",
    "@react-email/render": "2.0.0",
    "@sparticuz/chromium": "143.0.0",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "nodemailer": "7.0.11",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.8",
    "puppeteer-core": "^24.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-email": "5.0.8",
    "stream": "0.0.3",
    "tailwindcss": "^3.4.3",
    "vite": "^8.0.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "puppeteer": "^24.20.0",
    "typescript": "^5.9.3"
  }
}
