{
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsbuildinfo.json",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "baseUrl": ".",
    "plugins": [{ "name": "react" }],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
